{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/render-grilla/route.tsx": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/morning-fetch",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/process-approvals",
      "schedule": "*/30 * * * *"
    }
  ]
}
